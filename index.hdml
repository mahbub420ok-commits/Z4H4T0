  <!-- Reader / Live Modal -->
  <div class="modal-backdrop" id="modalBackdrop">
    <div class="modal">
      <button class="modal-close" id="modalClose" aria-label="Close">×</button>
      <div class="modal-body" id="modalBody"></div>
    </div>
  </div>

<script>
  // Theme Toggle
  const root = document.documentElement;
  const themeBtn = document.getElementById('themeToggle');
  if (localStorage.getItem('dn-theme') === 'dark') root.setAttribute('data-theme', 'dark');
  themeBtn.addEventListener('click', () => {
    const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    localStorage.setItem('dn-theme', next);
  });

  // Mobile Menu
  const menuBtn = document.getElementById('menuToggle');
  const mainNav = document.getElementById('mainNav');
  menuBtn.addEventListener('click', () => mainNav.classList.toggle('open'));

  // Category Filtering
  const navLinks = mainNav.querySelectorAll('a');
  const cards = document.querySelectorAll('#newsGrid .article-card');
  const feedTitle = document.getElementById('feedTitle');

  function filterCategory(cat, label) {
    navLinks.forEach(a => a.classList.toggle('active', a.dataset.cat === cat));
    feedTitle.textContent = cat === 'all' ? 'Latest News' : label;
    cards.forEach(card => {
      const match = cat === 'all' || card.dataset.cat === cat;
      card.classList.toggle('hide', !match);
    });
    mainNav.classList.remove('open');
  }

  navLinks.forEach(link => {
    link.addEventListener('click', e => {
      e.preventDefault();
      filterCategory(link.dataset.cat, link.textContent);
    });
  });

  document.getElementById('resetFilter').addEventListener('click', e => {
    e.preventDefault();
    filterCategory('all', 'Latest News');
  });

  // Search Filter
  document.getElementById('searchInput').addEventListener('input', e => {
    const q = e.target.value.toLowerCase().trim();
    cards.forEach(card => {
      const text = card.textContent.toLowerCase();
      card.classList.toggle('hide', q && !text.includes(q));
    });
  });

  // Load More
  const loadMoreBtn = document.getElementById('loadMoreBtn');
  loadMoreBtn.addEventListener('click', () => {
    document.querySelectorAll('.extra-card').forEach(c => c.classList.remove('hide'));
    loadMoreBtn.style.display = 'none';
  });

  // Back to Top
  const toTop = document.getElementById('toTop');
  window.addEventListener('scroll', () => {
    toTop.classList.toggle('show', window.scrollY > 400);
  });
  toTop.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));

  // Modal Preview for Articles & Live TV
  const backdrop = document.getElementById('modalBackdrop');
  const modalBody = document.getElementById('modalBody');
  const openModal = html => { modalBody.innerHTML = html; backdrop.classList.add('open'); };
  document.getElementById('modalClose').addEventListener('click', () => backdrop.classList.remove('open'));
  backdrop.addEventListener('click', e => { if (e.target === backdrop) backdrop.classList.remove('open'); });

  document.querySelectorAll('.article-card, .side-card, .lead').forEach(item => {
    item.style.cursor = 'pointer';
    item.addEventListener('click', () => {
      const title = item.querySelector('h1, h3').textContent;
      const img = item.querySelector('img').src;
      const cat = (item.querySelector('.cat, .tag') || { textContent: 'News' }).textContent;
      openModal(`
        <span class="tag">${cat}</span>
        <h2>${title}</h2>
        <div class="meta"><span>Desh News Desk</span> • <span>Published Today</span></div>
        <img src="${img}" alt="${title}">
        <p>Full coverage from our correspondents on the ground confirms major developments surrounding this story. Officials and industry analysts note that upcoming policy implementations will shape the next phase of progress.</p>
        <p>Stay tuned to Desh News 24/7 for live updates, expert interviews, and verified field reports as new details emerge.</p>
      `);
    });
  });

  document.getElementById('liveTvBtn').addEventListener('click', () => {
    openModal(`
      <span class="tag">● LIVE BROADCAST</span>
      <h2>Desh News 24/7 Live Stream</h2>
      <div style="aspect-ratio:16/9;background:#0b1220;border-radius:12px;display:grid;place-items:center;color:#fff;margin-top:14px;text-align:center;padding:20px;">
        <div>
          <div style="font-size:42px;color:#d0021b;margin-bottom:8px;">▶</div>
          <strong>Live Stream Ready</strong>
          <p style="font-size:13px;color:#94a3b8;margin-top:6px;">Connect your HLS/YouTube live stream embed URL here.</p>
        </div>
      </div>
    `);
  });

  // Newsletter Submit
  document.getElementById('newsletterForm').addEventListener('submit', e => {
    e.preventDefault();
    e.target.innerHTML = '<p style="color:#4ade80;font-weight:700;margin:0;">✓ Subscribed! You will receive the 7 AM briefing.</p>';
  });
</script>
</body>
</html>
